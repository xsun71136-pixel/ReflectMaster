<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.ReflectMaster" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/rm_primary</item>
        <item name="colorSecondary">@color/rm_secondary</item>
        <item name="colorTertiary">@color/rm_tertiary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Widget.ReflectMaster.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">1dp</item>
        <item name="contentPadding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="TextAppearance.ReflectMaster.CardTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
    </style>

</resources>
